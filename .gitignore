# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local environments and credentials
.venv/
venv/
.env
.env.*
!.env.example

# Local smoke tests and generated results
.smoke-test/
output/
results/
*.log
*.part
*.tmp

